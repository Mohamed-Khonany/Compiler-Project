methods	:	('public'|MODIFIRE)^ (STATIC)? ('void'|'int' | 'double' | 'float' | 'boolean'|ID)^ ID '('( ('int' | 'double' | 'float' | 'boolean'|ID)^ ID (',' ('int' | 'double' | 'float' | 'boolean'|ID)^ ID)* )?')' '{' ((code|nodereturn)+ | nodereturn*)^ '}' ;
