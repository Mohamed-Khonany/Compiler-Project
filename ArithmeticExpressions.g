grammar MiniJava;

options {output=AST;}
tokens{
Start;
//Term;
Factor;
Simicoln;
Oprations;
ClassDefinition;
ClassInitaltion;
//Classes;
InitInt;
InitDouble;
InitFloat;
InitBoolean;
ISO;
Assign;
ValueInitaltion;
IF_Statment;
CONDTION;
IF;
ELSEIF;
ELSE;
FOR_LOOP;
WHILE_LOOP;
DO_WHILE_LOOP;
PrintStatment;
PrintWord;
PRINT_OPR;
MAIN_METHOD;
METHOD;
CALL;
CALL_CLASS;
PRAMETER_CALL_CLASS;
Value_PCC;
RETURN;
OPJ;
INT_ARRAY;
DOUBLE_ARRAY;
InitOther;
}
@members {
String s="";
}

// Arithmetic Expressions
start: classes -> ^(Start classes);
// catch blocks go first
catch[MismatchedTokenException e] { s = s +getErrorMessage(e,new String[]{e.input.toString()})+": "+getErrorHeader(e) +"\n";}
catch[NoViableAltException e] { s = s +getErrorMessage(e,new String[]{e.input.toString()})+": "+getErrorHeader(e) +"\n";}
catch[RecognitionException e] { s = s +getErrorMessage(e,new String[]{e.input.toString()})+": "+getErrorHeader(e) +"\n";}
    
// The finally clause is the last part a rule executes before returning.
finally { s = s + "Exit..."+"\n"; }

classes	:	((classInit classDef*)|commint)^;
